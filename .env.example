# Copy to .env locally (never commit .env). Render: set these in the dashboard.

# --- MLflow (optional) ---
# Local Docker stack: docker compose up -d  →  http://127.0.0.1:5000
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT_NAME=predictive-maintenance

# --- Kafka (local: docker compose up -d) ---
# From your machine (producer/consumer scripts): localhost:9092
# From containers on the compose network: kafka:29092
KAFKA_BOOTSTRAP=localhost:9092
# Alternative name supported by scripts:
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sensor-data

# --- Render deploy hook (optional, GitHub Actions) ---
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxx?key=...

# --- API ---
# PORT is set automatically on Render
