FROM python:3.11-slim

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir mlflow==2.10.2

WORKDIR /mlflow

# Render sets PORT; local Docker Compose maps 5000:5000
EXPOSE 5000

CMD ["sh", "-c", "exec mlflow server --host 0.0.0.0 --port ${PORT:-5000} --backend-store-uri sqlite:////mlflow/mlflow.db --default-artifact-root file:///mlflow/artifacts"]
